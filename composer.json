{
	"name": "celema/dev",
	"description": "Shared development settings and tools for all Celema projects",
	"type": "library",
	"homepage": "https://celema.dev",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celema.dev"
		}
	],
	"require": {
		"php": "^8.5",
		"ernst/coverlyzer": "^0.3",
		"phpunit/phpunit": "^13.0",
		"psy/psysh": "*",
		"vimeo/psalm": "^6.16",
		"carthage-software/mago": "1.26.0"
	},
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"Celema\\Development\\": "src/"
		}
	},
	"scripts": {
		"lint": "./vendor/bin/mago fmt --check && ./vendor/bin/mago lint",
		"docs:lint": "npx markdownlint-cli2@0.22.1 --config config/markdownlint.jsonc README.md CHANGELOG.md LICENSE.md",
		"mdlint": "composer docs:lint",
		"ci": [
			"composer lint",
			"composer docs:lint"
		]
	},
	"bin": [
		"bin/docs-test-runner"
	]
}
